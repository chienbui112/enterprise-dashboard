# Sao chép file này thành .env.local và điền key của bạn (.env.local KHÔNG được commit).
# Thiếu key -> chế độ Google/MapTiler của dashboard 3D Flood Twin sẽ báo lỗi và ở lại synthetic.

# Google Photorealistic 3D Tiles — bật "Map Tiles API" trên Cloud project
VITE_GOOGLE_3D_TILES_KEY=

# MapTiler (OpenMapTiles vector tiles) — nhớ allowlist origin tại cloud.maptiler.com
VITE_MAPTILER_KEY=

# Cesium ion token — bật OSM Buildings (3D Tiles) + Cesium World Terrain cho dashboard
# "Cesium Digital Twin · Ngập lụt". Lấy free tại https://ion.cesium.com. Thiếu -> nhà tổng hợp.
VITE_CESIUM_ION_TOKEN=
